# OS and editor files
.DS_Store
*.class
*.log
*.pyc
*.swp
*.iml
*.ipr
*.iws
.idea/
.atom/
.history
.svn/
.build/
.buildlog/
.swiftpm/
migrate_working_dir/

# Keep shared VS Code launch configurations and tasks in version control.

# Flutter / Dart caches and build output
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
.widget_preview/

# Local test files
/test/

# Release symbols and obfuscation maps
app.*.symbols
app.*.map.json

# Android Studio build output
/android/app/debug/
/android/app/profile/
/android/app/release/

# Build outputs and dependencies from the archived React comparison.
/react/node_modules/
/react/dist/
/react/test-results/
/react/playwright-report/
/react/coverage/

# Local environment files; commit example files with placeholders only.
.env
.env.*
!.env.example
!.env.*.example
.envrc
# Local dart-define files; commit config/dart_defines.example.json only.
/config/*.local.json

# Keep lib/, pubspec.lock, .metadata, and generated Dart source files tracked.
# Platform-specific caches are excluded by each platform's .gitignore.
